# Software Release Radar Docker settings
#
# Copy this file to .env before starting the stack:
#   cp .env.example .env
#
# Keep your real .env file local. It is ignored by Git and must not be committed.

# Local image tag used when building from this repository.
SRR_VERSION=dev

# Port exposed on the Docker host.
SRR_HOST_PORT=9120

# Port used by the application inside the container.
SRR_CONTAINER_PORT=9120

# Host-side directory used for persistent application data.
SRR_DATA_DIR=./data

# Optional application and integration settings will be documented here after
# the sanitised v2.6.3 source has been imported and the public configuration
# surface has been audited. Do not add real tokens, passwords or private URLs
# to .env.example.
