# Software Release Radar
# Recommended first run:
#   bash scripts/setup.sh
#
# The setup script creates .env with secure application secrets and keeps the
# password itself out of this file.

RADAR_VERSION=2.6.3
RADAR_BIND_ADDRESS=0.0.0.0
RADAR_PORT=9120

# Automatic release checking. Each scheduler cycle only checks trackers that
# are due according to their individual refresh interval.
RADAR_SCHEDULER_INTERVAL_SECONDS=60
RADAR_SCHEDULER_LOG_RESULTS=false
RADAR_LOG_LEVEL=INFO

ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

SECRET_KEY=
ENCRYPTION_KEY=

# Optional. Raises GitHub API rate limits for release checks.
GITHUB_TOKEN=

# Set true when the application is only accessed over HTTPS.
SESSION_COOKIE_SECURE=false

# Set true only when Release Radar is directly behind one trusted reverse proxy.
TRUST_PROXY_HEADERS=false
